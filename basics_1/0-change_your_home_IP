#!/usr/bin/env bash
# Configures the Ubuntu server so localhost resolves to 127.0.0.2
# and facebook.com resolves to 8.8.8.8

# 1. Update localhost mapping from 127.0.0.1 to 127.0.0.2
# This targets the specific line where 127.0.0.1 maps to localhost
sudo sed -i 's/127\.0\.0\.1\s\+localhost/127.0.0.2 localhost/g' /etc/hosts

# 2. Add or update facebook.com mapping to 8.8.8.8
# If facebook.com already exists in the file, update its IP to 8.8.8.8
if grep -q "facebook\.com" /etc/hosts; then
    sudo sed -i 's/[0-9.]\+\s\+facebook\.com/8.8.8.8 facebook.com/g' /etc/hosts
else
    # If facebook.com doesn't exist, append it to the end of the file
    echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts > /dev/null
fi