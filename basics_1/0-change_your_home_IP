#!/usr/bin/env bash
# Configures the Ubuntu server so localhost resolves to 127.0.0.2
# and facebook.com resolves to 8.8.8.8

# 1. Back up /etc/hosts to the expected temporary file
sudo cp /etc/hosts ~/temp

# 2. Specific replacement of the localhost IP in the temporary file
sudo sed -i '/127.0.0.1\s\+localhost/s/127.0.0.1/127.0.0.2/' ~/temp

# 3. Add facebook.com entry if it does not already exist with the correct IP
if ! grep -q "8.8.8.8 facebook.com" ~/temp; then
  echo "8.8.8.8 facebook.com" | sudo tee -a ~/temp > /dev/null
fi

# 4. Safely overwrite the original file with the modified one
sudo cp -f ~/temp /etc/hosts

# 5. Clean up the temporary file
rm -f ~/temp