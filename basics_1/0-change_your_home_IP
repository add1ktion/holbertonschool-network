#!/bin/bash
# Configures the Ubuntu server so localhost resolves to 127.0.0.2
# and facebook.com resolves to 8.8.8.8

# Replace 127.0.0.1 with 127.0.0.2 for localhost mapping in /etc/hosts
sed -i 's/127.0.0.1/127.0.0.2/g' /etc/hosts

# Update or append facebook.com resolution to 8.8.8.8
if grep -q "facebook.com" /etc/hosts; then
    sed -i 's/.*facebook.com/8.8.8.8 facebook.com/' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi
